<?xml version="1.0" encoding="utf-8"?>
<!-- Template for the Microsoft Store (MSIX) build. publish.ps1 fills in the {TOKENS}.
     Identity Name / Publisher must be copied from Partner Center (Product identity). -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
  IgnorableNamespaces="uap rescap desktop desktop6">

  <Identity Name="{IDENTITY_NAME}" Publisher="{PUBLISHER}" Version="{VERSION}" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>TidyDesktop</DisplayName>
    <PublisherDisplayName>{PUBLISHER_DISPLAY_NAME}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <!-- Keep %APPDATA%\TidyDesktop the real folder, so the tray's "open settings folder", the log file,
         custom language files and settings from the zip build all see the same place. -->
    <desktop6:FileSystemWriteVirtualization>disabled</desktop6:FileSystemWriteVirtualization>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
    <Resource Language="ko-kr" />
    <Resource Language="ja-jp" />
    <Resource Language="zh-cn" />
    <Resource Language="es-es" />
    <Resource Language="de-de" />
    <Resource Language="fr-fr" />
    <Resource Language="pt-br" />
    <Resource Language="ru-ru" />
  </Resources>

  <Applications>
    <Application Id="TidyDesktop" Executable="TidyDesktop.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="TidyDesktop"
        Description="Keeps desktop icons tidy in boxes"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" Square310x310Logo="Assets\Square310x310Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- Start with Windows; the user can switch it off in Settings > Apps > Startup. -->
        <desktop:Extension Category="windows.startupTask" Executable="TidyDesktop.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="TidyDesktopStartup" Enabled="false" DisplayName="TidyDesktop" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- A desktop (Win32/WPF) app: it works on the real desktop shell, outside the app sandbox. -->
    <rescap:Capability Name="runFullTrust" />
    <!-- Required by FileSystemWriteVirtualization above. -->
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>
</Package>
